# Leave both blank to run against the built-in realistic mock feed (recommended for grading/demo).
# Fill both in to hit a real provider (Finnhub, Alpha Vantage, Twelve Data, etc).
VITE_STOCK_API_BASE_URL=
VITE_STOCK_API_KEY=

# Optional: 0-1, probability an individual mock request fails (default 0.18).
# Raise it to trip the circuit breaker faster during a demo.
VITE_MOCK_FAILURE_RATE=0.18
